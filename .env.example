# Copy this file to .env (it is ignored by git) and set your API base URL.
# BASE_URL is read at build time and baked into BuildConfig.
#
# Precedence: -PBASE_URL=... (Gradle property) > .env > local.properties > default emulator URL.
#
# In CI, set BASE_URL in GitHub:
# Settings -> Secrets and variables -> Actions -> Variables -> New repository variable.
# The workflow passes it to Gradle as -PBASE_URL and overrides the value below.
BASE_URL=https://api.example.com/
